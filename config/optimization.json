{
    "version": "3.3.0",
    "description": "7代CPU老电脑优化配置文件",
    "services": {
        "safe_to_disable": [
            { "name": "DiagTrack",         "desc": "诊断跟踪服务（遥测）" },
            { "name": "dmwappushservice",  "desc": "WAP 推送消息路由" },
            { "name": "WerSvc",            "desc": "Windows 错误报告" },
            { "name": "XblAuthManager",    "desc": "Xbox Live 身份验证" },
            { "name": "XblGameSave",       "desc": "Xbox Live 游戏保存" },
            { "name": "XboxGipSvc",        "desc": "Xbox 附件管理" },
            { "name": "XboxNetApiSvc",     "desc": "Xbox Live 网络服务" },
            { "name": "Fax",               "desc": "传真服务" },
            { "name": "RemoteRegistry",    "desc": "远程注册表" },
            { "name": "RetailDemo",        "desc": "零售演示服务" }
        ],
        "recommended_to_disable": [
            { "name": "SensorService",           "desc": "传感器服务" },
            { "name": "SensrSvc",                "desc": "传感器监控" },
            { "name": "WMPNetworkSvc",           "desc": "WMP 网络共享" },
            { "name": "HvHost",                  "desc": "HV 主机服务" },
            { "name": "vmickvpexchange",         "desc": "Hyper-V 数据交换" },
            { "name": "vmicguestinterface",      "desc": "Hyper-V 来宾接口" },
            { "name": "vmicshutdown",            "desc": "Hyper-V 关机" },
            { "name": "vmicheartbeat",           "desc": "Hyper-V 心跳" },
            { "name": "vmicvmsession",           "desc": "Hyper-V PowerShell" },
            { "name": "vmicrdv",                 "desc": "Hyper-V 远程桌面" },
            { "name": "vmictimesync",            "desc": "Hyper-V 时间同步" }
        ]
    },
    "dns_options": {
        "aliyun":      ["223.5.5.5", "223.6.6.6"],
        "tencent":     ["119.29.29.29", "119.28.28.28"],
        "114":         ["114.114.114.114", "114.114.115.115"],
        "google":      ["8.8.8.8", "8.8.4.4"],
        "cloudflare":  ["1.1.1.1", "1.0.0.1"]
    },
    "disk": {
        "compact_os_default": false
    },
    "profiles": {
        "old_balanced": {
            "title": "老机均衡",
            "desc": "通用首选：安全禁用服务、关闭动画特效、切高性能电源",
            "services": "safe",
            "startup": "list",
            "visual": "best_performance",
            "power": "high",
            "dns": "cloudflare",
            "telemetry": true,
            "disk": "none",
            "compact_os": false
        },
        "gaming": {
            "title": "游戏加速",
            "desc": "更激进：safe+recommended 服务全禁、动画全关、卓越性能、阿里 DNS",
            "services": "recommended",
            "startup": "all",
            "visual": "best_performance",
            "power": "ultimate",
            "dns": "aliyun",
            "telemetry": true,
            "disk": "none",
            "compact_os": false
        },
        "quiet_saver": {
            "title": "静音省电",
            "desc": "笔记本电池模式：仅安全禁用服务、保留基本动画、切省电计划",
            "services": "safe",
            "startup": "list",
            "visual": "balanced",
            "power": "power_saver",
            "dns": "114",
            "telemetry": true,
            "disk": "none",
            "compact_os": false
        },
        "minimal": {
            "title": "最小干预",
            "desc": "几乎不动系统：仅关闭遥测计划任务，服务/动画/电源/DNS 全部保持原状",
            "services": "none",
            "startup": "none",
            "visual": "keep",
            "power": "keep",
            "dns": "none",
            "telemetry": true,
            "disk": "none",
            "compact_os": false
        }
    },
    "telemetry_tasks": [
        "\\Microsoft\\Windows\\Application Experience\\Microsoft Compatibility Appraiser",
        "\\Microsoft\\Windows\\Application Experience\\ProgramDataUpdater",
        "\\Microsoft\\Windows\\Customer Experience Improvement Program\\Consolidator",
        "\\Microsoft\\Windows\\Customer Experience Improvement Program\\UsbCeip",
        "\\Microsoft\\Windows\\DiskDiagnostic\\Microsoft-Windows-DiskDiagnosticDataCollector"
    ],
    "clean_targets": [
        { "key": "temp",     "name": "Windows 系统临时文件",     "path": "C:\\Windows\\Temp",                                   "web": true },
        { "key": "usertemp", "name": "用户临时文件",             "path": "%TEMP%",                                              "web": true },
        { "key": "prefetch", "name": "预读取文件",               "path": "C:\\Windows\\Prefetch",                               "web": true },
        { "key": "wsus",     "name": "Windows Update 下载缓存",  "path": "C:\\Windows\\SoftwareDistribution\\Download",         "web": true },
        { "key": "thumb",    "name": "缩略图缓存",               "path": "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer",        "web": true },
        { "key": "wer",      "name": "Windows 错误报告",         "path": "%PROGRAMDATA%\\Microsoft\\Windows\\WER",              "web": true }
    ]
}
