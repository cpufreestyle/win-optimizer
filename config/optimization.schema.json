{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/PC-Optimizer/optimization.schema.json",
  "title": "PC-Optimizer optimization config",
  "type": "object",
  "required": ["version", "services", "dns_options", "telemetry_tasks"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "应用版本号，须与 OptimizeGUI.ps1 / Optimize.ps1 / Build-EXE.ps1 保持一致"
    },
    "description": { "type": "string" },
    "update_repo": {
      "type": "string",
      "pattern": "^[\\w.-]+/[\\w.-]+$",
      "description": "可选；GitHub owner/repo，用于更新检查；缺省时自动从 git remote 探测"
    },
    "services": {
      "type": "object",
      "required": ["safe_to_disable", "recommended_to_disable"],
      "properties": {
        "safe_to_disable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "desc"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "desc": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "recommended_to_disable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "desc"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "desc": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "dns_options": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1,
        "maxItems": 2
      }
    },
    "safety": {
      "type": "object",
      "description": "安全相关开关；create_restore_point 控制「修复 / 组合包执行前是否先建系统还原点」，默认 false。",
      "properties": {
        "create_restore_point": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "smart": {
      "type": "object",
      "description": "智能建议的准确性护栏：trusted_publishers 是受保护厂商的签名特征列表（子串匹配，大小写不敏感）。命中即不推荐禁用对应启动项——名字黑名单管不住改名 / 换目录的系统组件，而它们几乎都带有效数字签名。留空或缺省时 lib 回退内置默认。",
      "properties": {
        "trusted_publishers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "description": "优化组合包（Profiles）：name -> {title, desc, services, startup, visual, power, dns, telemetry, disk, compact_os}。config 驱动，社区可直接贡献；缺失时 lib 回退内置默认。",
      "additionalProperties": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "desc": { "type": "string" },
          "services": { "type": "string", "enum": ["none", "safe", "recommended", "all"] },
          "startup": { "type": "string", "enum": ["none", "list", "all"] },
          "visual": { "type": "string", "enum": ["keep", "balanced", "best_performance"] },
          "power": { "type": "string", "pattern": "^(keep|high|ultimate|balanced|power_saver|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$" },
          "dns": { "type": "string", "enum": ["none", "cloudflare", "google", "aliyun", "114", "tencent"] },
          "telemetry": { "type": "boolean" },
          "disk": { "type": "string", "enum": ["none", "optimize"] },
          "compact_os": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "telemetry_tasks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
